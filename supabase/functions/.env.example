# Secretos de las Edge Functions (marcadores). Los reales los pone Ricardo con:
#   npx supabase secrets set NOMBRE=valor
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase.

# App (ya configurados en veta-dev)
APP_URL=http://localhost:5173
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.*:5173
PORTAL_SALT=               # openssl rand -hex 32 (ya puesto en veta-dev)

# Correo (Resend) · invitar, notificar, avisos-prueba. Sin ellos: "no_configurado" y la app ofrece WhatsApp.
RESEND_API_KEY=            # empieza con re_
EMAIL_FROM="Veta <avisos@tudominio.com>"

# Stripe (suscripción de Veta) · stripe-checkout, stripe-portal, stripe-extras, stripe-webhook
# Montos con IVA incluido; anual = 10 meses (2 gratis).
STRIPE_SECRET_KEY=                # empieza con sk_test_ (pruebas) o sk_live_ (producción)
STRIPE_WEBHOOK_SECRET=            # empieza con whsec_
STRIPE_PRICE_TALLER_MENSUAL=      # price_… · $300 al mes
STRIPE_PRICE_TALLER_ANUAL=        # price_… · $3,000 al año
STRIPE_PRICE_MUEBLERIA_MENSUAL=   # price_… · $500 al mes
STRIPE_PRICE_MUEBLERIA_ANUAL=     # price_… · $5,000 al año
STRIPE_PRICE_DESPACHO_MENSUAL=    # price_… · $500 al mes (a la venta cuando exista Proyectos)
STRIPE_PRICE_DESPACHO_ANUAL=      # price_… · $5,000 al año
STRIPE_PRICE_EXTRA_MENSUAL=       # price_… · usuario adicional $100 al mes
STRIPE_PRICE_EXTRA_ANUAL=         # price_… · usuario adicional $1,000 al año

# Avisos programados · avisos-prueba (lo llama pg_cron con este secreto)
CRON_SECRET=               # openssl rand -hex 32

# Mercado Pago: no hay secretos globales. Cada mueblería conecta su propio Access Token en Ajustes.
