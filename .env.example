# ───────── Frontend (Netlify → Site settings → Environment variables) ─────────
# Solo claves públicas. Nunca pongas aquí service_role ni claves secretas.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_APP_URL=https://app.tudominio.com

# ───────── Edge Functions (supabase secrets set --env-file supabase/.env) ─────────
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY ya vienen inyectadas por Supabase.
APP_URL=https://app.tudominio.com

# Stripe · suscripción de Veta (los precios se definen en el panel de Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MENSUAL=price_...
STRIPE_PRICE_ANUAL=price_...

# Mercado Pago: no requiere secretos globales. Cada mueblería conecta su propio
# Access Token desde Ajustes > Cobros en línea (se guarda en empresa_secretos).

# Correo transaccional
RESEND_API_KEY=re_...
EMAIL_FROM="Veta <avisos@tudominio.com>"

# Portal público: sal para hashear IPs en el límite de intentos
PORTAL_SALT=cambia-esto-por-una-cadena-larga-aleatoria
